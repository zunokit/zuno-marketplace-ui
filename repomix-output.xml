                          </span>
                          <span className="text-xs text-os-gray-300">{currency}</span>
                        </div>
                        <span
                          className={cn(
                            "w-14 text-right text-xs font-medium",
                            priceChange >= 0 ? "text-success" : "text-destructive"
                          )}
                        >
                          {priceChange >= 0 ? "+" : ""}
                          {priceChange.toFixed(1)}%
                        </span>
                      </div>
                    </Link>
                  ) : (
                    <Link
