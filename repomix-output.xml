          aria-label="Agree to terms of service"
        />
        <Label htmlFor="terms" className="text-sm text-os-gray-300 leading-tight">
          By clicking mint, you agree to the{" "}
          <a
            href="#"
            className="text-primary hover:underline"
            target="_blank"
            rel="noopener noreferrer"
          >
            Terms of Service
          </a>
          .
        </Label>
      </div>
    </div>
  );
}
