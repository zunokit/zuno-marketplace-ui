          </div>

          {/* Right Content - Search Results */}
          <ScrollArea className="flex-1">
            {!searchTerm ? (
              <div className="p-6 space-y-6">
                {/* Trending Searches */}
                <div>
                  <div className="flex items-center gap-2 text-sm font-medium text-os-gray-300 mb-3">
