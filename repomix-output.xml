                  <span className={`font-bold ${auction.reserveMet ? "text-emerald-600 dark:text-emerald-400" : "text-amber-600 dark:text-amber-400"}`}>
                    {auction.reserveMet ? "✓ Met" : `${auction.reservePrice} ${auction.currency}`}
