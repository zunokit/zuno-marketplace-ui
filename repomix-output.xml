    id: 2,
    name: "Azuki",
    image: "https://picsum.photos/50/50?random=2",
    floor: "15.2 ETH",
    volume: "89K ETH",
    change: "+8.2%",
    verified: true,
  },
  {
    id: 3,
    name: "Doodles",
