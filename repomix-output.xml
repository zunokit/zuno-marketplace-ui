          <div className="flex items-center gap-2 mt-2 mb-3">
            <Image
              src={nft.owner.avatar}
              alt={nft.owner.name}
              width={20}
              height={20}
              className="rounded-full"
            />
            <span className="text-xs text-os-gray-300">@{nft.owner.name}</span>
            {nft.owner.verified && (
              <Badge variant="secondary" className="text-xs px-1">
