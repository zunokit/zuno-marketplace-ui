                      href={`/collections/${collection.slug}`}
                      className="flex items-center justify-between rounded-[6px] p-2.5 transition-all duration-150 hover:bg-secondary/50"
                    >
                      <div className="flex items-center gap-3 min-w-0 flex-1">
