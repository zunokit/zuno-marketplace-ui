export default function MintForm() {
  const {
    collection,
    isSameArtType,
    isAllowlistMint,
    agreedToTerms,
    setAgreedToTerms,

    // Token standard flags
    isERC1155,
    mintCostData,
    SUPPORTS_BATCH,
    selectedEdition,
    mockEditions,
  } = useMintState();

  const MINT_LIMIT = 100;
